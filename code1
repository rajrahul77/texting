-- Step 1: Train the ML Model on your existing Warehouse Daily view
CREATE OR REPLACE SNOWFLAKE.ML.FORECAST ECOMMERCE_DEV.COST_ANALYTICS.COST_FORECASTER (
  INPUT_DATA => SYSTEM$REFERENCE('VIEW', 'ECOMMERCE_DEV.COST_ANALYTICS.VW_WAREHOUSE_DAILY'),
  TIMESTAMP_COLNAME => 'USAGE_DATE',
  TARGET_COLNAME => 'CREDITS_USED'
);

-- Step 2: Create a view that dynamically calls the ML model to project 30 days out
CREATE OR REPLACE VIEW ECOMMERCE_DEV.COST_ANALYTICS.VW_ML_SPEND_FORECAST AS 
SELECT 
    TS AS FORECAST_DATE, 
    FORECAST AS PREDICTED_CREDITS, 
    LOWER_BOUND AS OPTIMISTIC_SPEND, 
    UPPER_BOUND AS PESSIMISTIC_SPEND
FROM TABLE(ECOMMERCE_DEV.COST_ANALYTICS.COST_FORECASTER!FORECAST(FORECASTING_PERIODS => 30));
