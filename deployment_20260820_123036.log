2026-08-20 12:30:36,827 | INFO | Generated SQL:
CREATE OR REPLACE VIEW ECOMMERCE_DB.GOLD.AGG_MONTHLY_REVENUE
AS
SELECT
    DATE_TRUNC('MONTH', f.ORDER_DATE) AS ORDER_MONTH,
    COUNT(f.ORDER_ID) AS TOTAL_ORDERS,
    ROUND(SUM(f.TOTAL_REVENUE), 2) AS TOTAL_REVENUE,
    ROUND(AVG(f.TOTAL_REVENUE), 2) AS AVG_ORDER_VALUE
FROM ECOMMERCE_DB.GOLD.FACT_ORDERS f
WHERE f.ORDER_STATUS = 'delivered'
GROUP BY
    DATE_TRUNC('MONTH', f.ORDER_DATE);

COMMENT ON VIEW ECOMMERCE_DB.GOLD.AGG_MONTHLY_REVENUE IS 'Monthly revenue aggregation for trend analysis'
