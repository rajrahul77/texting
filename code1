            wh_row = df_sizing[df_sizing[wh_col] == selected_wh_sim].iloc[0]
            
            current_size = str(wh_row.get("WAREHOUSE_SIZE", "X-Small")).upper()
            clean_size = "X-Small"
            for s in SIZE_LIST:
                if s.upper().replace("-", "") in current_size.replace("-", ""):
                    clean_size = s

            col_s1, col_s2, col_s3 = st.columns(3)
            with col_s1:
                new_size = st.select_slider("Simulated Size", options=SIZE_LIST, value=clean_size)
            with col_s2:
                new_auto_suspend = st.slider("Auto-Suspend Timeout (s)", 0, 600, 60, step=30)
            with col_s3:
                growth_pct = st.slider("Query Volume Adjustment %", -50, 200, 0, step=10)

            current_credits_hr = SIZE_CREDITS.get(clean_size, 1)
            new_credits_hr = SIZE_CREDITS.get(new_size, 1)
            daily_active_hrs = safe_num(wh_row.get("CREDITS_PER_DAY", 0)) / current_credits_hr if current_credits_hr > 0 else 0

            current_monthly = safe_num(wh_row.get("CREDITS_PER_DAY", 0)) * 30
            new_daily = daily_active_hrs * new_credits_hr * (1 + growth_pct / 100)
            new_monthly = new_daily * 30
            savings = current_monthly - new_monthly

            col_r1, col_r2, col_r3 = st.columns(3)
            with col_r1:
                st.metric("Baseline Monthly (Credits)", f"{current_monthly:,.2f}")
            with col_r2:
                st.metric("Simulated Monthly (Credits)", f"{new_monthly:,.2f}")
            with col_r3:
                st.metric("Projected Monthly Savings (Credits)", f"{savings:,.2f}")

            if savings > 0:
                st.success(f"Resizing {selected_wh_sim} to {new_size} could save ~{savings:,.1f} credits/month.")


