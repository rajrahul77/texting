2026-08-20 12:30:36,828 | INFO | Generated SQL:
CREATE OR REPLACE VIEW ECOMMERCE_DB.GOLD.AGG_REVENUE_BY_CATEGORY
AS
SELECT
    COALESCE(fi.PRODUCT_CATEGORY, 'unknown') AS PRODUCT_CATEGORY,
    COUNT(DISTINCT fi.ORDER_ID) AS TOTAL_ORDERS,
    ROUND(SUM(fi.PRICE), 2) AS TOTAL_REVENUE,
    ROUND(AVG(fi.PRICE), 2) AS AVG_PRICE,
    COUNT(DISTINCT fi.SELLER_ID) AS SELLER_COUNT
FROM ECOMMERCE_DB.GOLD.FACT_ORDER_ITEMS fi
WHERE fi.ORDER_STATUS = 'delivered'
GROUP BY
    COALESCE(fi.PRODUCT_CATEGORY, 'unknown');

